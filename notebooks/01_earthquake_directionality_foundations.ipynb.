        "# Experiment 1A: Generate synthetic horizontal acceleration components\n",
        "\n",
        "dt = 0.01                   # Sampling interval in seconds\n",
        "duration = 10.0             # Signal duration in seconds\n",
        "frequency = 1.0             # Illustrative frequency in Hz\n",
        "\n",
        "t = np.arange(0, duration, dt)\n",
        "\n",
        "# Two perpendicular horizontal acceleration components\n",
        "ax = 1.2 * np.sin(2 * np.pi * frequency * t)\n",
        "ay = 0.6 * np.sin(\n",
        "    2 * np.pi * frequency * t + np.pi / 3\n",
        ")\n",
        "\n",
        "acceleration = pd.DataFrame({\n",
        "    \"time_s\": t,\n",
        "    \"ax_m_s2\": ax,\n",
        "    \"ay_m_s2\": ay\n",
        "})\n",
        "\n",
        "print(\"Number of samples:\", len(acceleration))\n",
        "print(\"Sampling interval:\", dt, \"seconds\")\n",
        "print(\"Sampling frequency:\", 1 / dt, \"Hz\")\n",
        "print(\"\\nFirst five samples:\")\n",
        "display(acceleration.head())\n",
        "\n",
        "# Save the synthetic data\n",
        "acceleration.to_csv(\n",
        "    OUTPUT_DIR / \"synthetic_horizontal_acceleration.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "# Plot both components\n",
        "plt.figure(figsize=(11, 4))\n",
        "plt.plot(t, ax, label=\"Horizontal component X\")\n",
        "plt.plot(t, ay, label=\"Horizontal component Y\")\n",
        "plt.xlabel(\"Time (s)\")\n",
        "plt.ylabel(\"Acceleration (m/s²)\")\n",
        "plt.title(\"Synthetic horizontal acceleration time histories\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\n",
        "    OUTPUT_DIR / \"01_acceleration_components.png\",\n",
        "    dpi=200\n",
        ")\n",
        "plt.show()"
