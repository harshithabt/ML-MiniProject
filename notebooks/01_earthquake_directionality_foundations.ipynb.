        "# Experiment 1C: Amplitude sensitivity experiment\n",
        "\n",
        "ax_modified = 2.4 * np.sin(\n",
        "    2 * np.pi * frequency * t\n",
        ")\n",
        "ay_modified = ay.copy()\n",
        "\n",
        "modified_responses = []\n",
        "\n",
        "for angle_deg in angles_deg:\n",
        "    theta = np.deg2rad(angle_deg)\n",
        "\n",
        "    projected = (\n",
        "        ax_modified * np.cos(theta)\n",
        "        + ay_modified * np.sin(theta)\n",
        "    )\n",
        "\n",
        "    modified_responses.append(\n",
        "        np.max(np.abs(projected))\n",
        "    )\n",
        "\n",
        "modified_responses = np.asarray(modified_responses)\n",
        "\n",
        "modified_index = np.argmax(modified_responses)\n",
        "modified_angle = angles_deg[modified_index]\n",
        "\n",
        "print(\"Original maximum-response angle:\", best_angle_deg, \"degrees\")\n",
        "print(\"Modified maximum-response angle:\", modified_angle, \"degrees\")\n",
        "print(\n",
        "    \"Original peak response:\",\n",
        "    round(best_peak, 4), \"m/s²\"\n",
        ")\n",
        "print(\n",
        "    \"Modified peak response:\",\n",
        "    round(modified_responses[modified_index], 4), \"m/s²\"\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(\n",
        "    angles_deg,\n",
        "    peak_responses,\n",
        "    label=\"Original X amplitude\"\n",
        ")\n",
        "plt.plot(\n",
        "    angles_deg,\n",
