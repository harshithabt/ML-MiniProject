        "# Experiment 1B: Sweep through horizontal orientations\n",
        "\n",
        "angles_deg = np.arange(0, 180, 1)\n",
        "peak_responses = []\n",
        "\n",
        "for angle_deg in angles_deg:\n",
        "    theta = np.deg2rad(angle_deg)\n",
        "\n",
        "    # Project the two horizontal components onto this direction\n",
        "    a_theta = (\n",
        "        ax * np.cos(theta)\n",
        "        + ay * np.sin(theta)\n",
        "    )\n",
        "\n",
        "    # Peak absolute projected acceleration\n",
        "    peak_response = np.max(np.abs(a_theta))\n",
        "    peak_responses.append(peak_response)\n",
        "\n",
        "peak_responses = np.asarray(peak_responses)\n",
        "\n",
        "best_index = np.argmax(peak_responses)\n",
        "best_angle_deg = angles_deg[best_index]\n",
        "best_peak = peak_responses[best_index]\n",
        "\n",
        "print(f\"Maximum-response orientation: {best_angle_deg}°\")\n",
        "print(f\"Peak projected acceleration: {best_peak:.4f} m/s²\")\n",
        "\n",
        "# Plot response against orientation\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(angles_deg, peak_responses)\n",
        "plt.axvline(\n",
        "    best_angle_deg,\n",
        "    linestyle=\"--\",\n",
        "    label=f\"Maximum at {best_angle_deg}°\"\n",
        ")\n",
        "plt.xlabel(\"Orientation (degrees)\")\n",
        "plt.ylabel(\"Peak absolute acceleration (m/s²)\")\n",
        "plt.title(\"Peak projected acceleration versus orientation\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\n",
        "    OUTPUT_DIR / \"02_orientation_sweep.png\",\n",
        "    dpi=200\n",
        ")\n",
        "plt.show()\n",
        "\n",
        "# Save numerical results\n",
        "orientation_results = pd.DataFrame({\n",
        "    \"orientation_deg\": angles_deg,\n",
        "    \"peak_acceleration_m_s2\": peak_responses\n",
        "})\n",
        "\n",
        "orientation_results.to_csv(\n",
        "    OUTPUT_DIR / \"orientation_sweep_results.csv\",\n",
        "    index=False\n",
        ")"
